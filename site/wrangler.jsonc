// shroom.am: the landing, the install line, the page for coding agents and What's new.
// Deployed by .github/workflows/site.yml on every push to main (after `node site/build.mjs`).
{
  "name": "shroom-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Only these reach worker.js; the favicons and og.png are served as they are, and free.
    "run_worker_first": ["/", "/next", "/install", "/agent", "/agent.md", "/cli", "/cli.md", "/whats-new", "/whats-new/*", "/faq", "/privacy", "/terms", "/feedback", "/report", "/how-to.mp4", "/hero-2.mp4", "/download/*", "/_/*"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "shroom.am", "custom_domain": true },
    { "pattern": "www.shroom.am", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  // Counts, not logs (worker.js says what one row holds).
  // The dataset is made on its first write and keeps rows three months.
  "analytics_engine_datasets": [{ "binding": "STATS", "dataset": "shroom_site" }],
  // POST /report (site/report.js): one message per report, to the inbox in the secret
  // REPORT_TO — a destination verified in Email Routing. The binding names no address: with
  // none, it can reach only the account's verified destinations, and the address stays out
  // of this repo. TURNSTILE_SECRET is the feedback form's check. Neither secret is here: they
  // live in the Worker (`wrangler secret put`). Without REPORT_TO, /report answers "off";
  // without TURNSTILE_SECRET, so does the feedback form's.
  "send_email": [{ "name": "EMAIL" }],
  // A few reports a minute from one address, and a ceiling for all of them (per Cloudflare
  // location): the feedback page's pair, and the app's own, tighter by address, so neither
  // door spends the other's budget. Without its pair, a door answers "off". The counters
  // are Cloudflare's own and short-lived; nothing else is kept.
  "ratelimits": [
    { "name": "REPORT_RATE", "namespace_id": "1801", "simple": { "limit": 3, "period": 60 } },
    { "name": "REPORT_CEILING", "namespace_id": "1802", "simple": { "limit": 30, "period": 60 } },
    { "name": "REPORT_APP_RATE", "namespace_id": "1803", "simple": { "limit": 2, "period": 60 } },
    { "name": "REPORT_APP_CEILING", "namespace_id": "1804", "simple": { "limit": 30, "period": 60 } }
  ],
  // No request logs: nothing about who visited is kept.
  "observability": { "enabled": false }
}
