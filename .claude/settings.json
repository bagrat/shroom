{
  "permissions": {
    "allow": [
      "Bash(bash dev/mac/loop.sh *)",
      "Bash(dev/mac/loop.sh *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
